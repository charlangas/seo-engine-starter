DATAFORSEO_LOGIN=you@example.com
DATAFORSEO_PASSWORD=your-api-password
SERPAPI_KEY=your-serpapi-key
# Optional: enables the Claude writing backend (otherwise the deterministic template composer is used)
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: real article writing through OpenRouter (writer model + editor model).
# Without it the engine falls back to template copy flagged draft: true.
OPENROUTER_API_KEY=

# Optional: daily Search Console check. Path to a Google service-account JSON key
# whose client_email has been added as a user on the Search Console property.
GSC_SERVICE_ACCOUNT_FILE=

# Optional: autopilot posts the weekly report to this Slack incoming webhook.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional: a monthly dollar cap for all sites together (each site can also set budget.monthly_usd).
# MONTHLY_BUDGET_USD=100
